{
    "show_edit_predictions": false,

    "format_on_save": "on",
    "show_wrap_guides": true,
    "preferred_line_length": 120,
    "soft_wrap": "editor_width",

    "languages": {
        "TypeScript": {
            "language_servers": ["deno", "!typescript-language-server", "!vtsls", "!eslint"],
            "formatter": "language_server",
        },
    },

    "lsp": {
        "deno": {
            "settings": {
                "deno": {
                    "enable": true,
                },
            },
        },
    },
}
